---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, url } from '../../lib/utils';

const entries = (await getCollection('devlogs')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const withProject = await Promise.all(
  entries.map(async (entry) => ({ entry, project: await getEntry(entry.data.project) })),
);
---

<BaseLayout title="Devlog">
  <h1 class="heading">Devlog</h1>
  <ul class="list">
    {
      withProject.map(({ entry, project }) => (
        <li>
          <time class="muted" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <div>
            <a href={url(`/devlogs/${entry.id}/`)}>{entry.data.title}</a>
            <span class="muted project">
              {' · '}
              <a href={url(`/projects/${project.id}/`)}>{project.data.title}</a>
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .heading { padding-top: var(--space-5); }
  .list { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .list li { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .list time { min-width: 8rem; font-size: var(--text-sm); }
  .project a { color: var(--color-text-muted); }
</style>
