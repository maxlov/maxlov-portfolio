---
import { siItchdotio, siSteam } from 'simple-icons';

interface Props {
  platform: 'itch' | 'steam';
  href: string;
}

const { platform, href } = Astro.props;
const icon = platform === 'itch' ? siItchdotio : siSteam;
const label = platform === 'itch' ? 'itch.io' : 'Steam';
---

<a class="badge" href={href} target="_blank" rel="noopener noreferrer">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
    <path d={icon.path} />
  </svg>
  <span>{platform === 'itch' ? 'Play on' : 'Wishlist on'} {label}</span>
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }
  .badge:hover { border-color: var(--color-accent); }
</style>
